# Kopiér til .env. Gem aldrig tokens i Git eller i chatten.
FACEBOOK_PAGE_ID=61595933881305
FACEBOOK_PAGE_ACCESS_TOKEN=
# En aktuelt understøttet Graph API-version fra dit Meta-appdashboard, fx vXX.0
META_GRAPH_VERSION=
PORT=3000
# Hosting kræver en stærk adgangskode på mindst 20 tegn. Brugernavnet er admin.
APP_PASSWORD=
# Billedgenerering er valgfri og slået fra. Kræver separat API-betaling ved aktivering.
AUTO_IMAGES_ENABLED=false
# OpenAI API-nøgle til billedgenerering (ikke dit ChatGPT-abonnement)
AI_IMAGE_API_KEY=
# På hosting bruges HOST=0.0.0.0. Lokalt beholdes 127.0.0.1.
HOST=127.0.0.1
DATA_DIR=./data
# Ved egen hosting: HTTPS-adressen. Render sætter automatisk sin adresse.
PUBLIC_URL=

# Til Facebook-login via Meta-app (alternativ til manuelt Page access token)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
